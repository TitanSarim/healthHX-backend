generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model MedicineUSA {
  PRODUCTID String @id
  PRODUCTNDC String? @default("")
  PRODUCTTYPENAME String? @default("")
  PROPRIETARYNAME String
  PROPRIETARYNAMESUFFIX String? @default("")
  NONPROPRIETARYNAME String? @default("")
  DOSAGEFORMNAME String? @default("")
  ROUTENAME String? @default("")
  STARTMARKETINGDATE String? @default("")
  ENDMARKETINGDATE String? @default("")
  MARKETINGCATEGORYNAME String? @default("")
  APPLICATIONNUMBER String? @default("")
  LABELERNAME String? @default("")
  SUBSTANCENAME String? @default("")
  ACTIVE_NUMERATOR_STRENGTH String? @default("")
  ACTIVE_INGRED_UNIT String? @default("")
  PHARM_CLASSES String? @default("")
  DEASCHEDULE String? @default("")
  AIMODELCHAT String?
  region Region @default(USA)
}


enum Region {
  USA
  AUS
  PAK
}